"""Procedural painterly materials for Vaelora Sculpted Diorama.

The material system intentionally avoids photo textures. Variation is generated from
object-space noise, surface orientation and restrained AO so assets feel authored
rather than uniformly flat while remaining readable at strategy scale.
"""
from __future__ import annotations


import bpy

from vaelora_style import FACTION_PALETTE_HEX, PALETTE_HEX

_CACHE: dict[str, bpy.types.Material] = {}


def hex_rgba(value: str) -> tuple[float, float, float, float]:
    value = value.lstrip("#")
    rgb = tuple(int(value[i:i + 2], 16) / 255.0 for i in (0, 2, 4))
    return (*rgb, 1.0)


def _rgb(value: str):
    return hex_rgba(value)


def _clear_nodes(mat: bpy.types.Material):
    mat.use_nodes = True
    nodes = mat.node_tree.nodes
    for node in list(nodes):
        nodes.remove(node)
    return mat.node_tree.nodes, mat.node_tree.links


def _principled(nodes, base_color, roughness: float, metallic: float = 0.0):
    bsdf = nodes.new("ShaderNodeBsdfPrincipled")
    bsdf.location = (430, 60)
    bsdf.inputs["Base Color"].default_value = base_color
    bsdf.inputs["Roughness"].default_value = roughness
    bsdf.inputs["Metallic"].default_value = metallic
    return bsdf


def create_painterly_material(
    name: str,
    shadow_hex: str,
    base_hex: str,
    light_hex: str,
    *,
    scale: float = 3.2,
    detail: float = 2.0,
    roughness: float = 0.82,
    bump_strength: float = 0.10,
    bump_distance: float = 0.10,
    metallic: float = 0.0,
) -> bpy.types.Material:
    if name in _CACHE:
        return _CACHE[name]
    mat = bpy.data.materials.new(name)
    nodes, links = _clear_nodes(mat)
    out = nodes.new("ShaderNodeOutputMaterial")
    out.location = (680, 60)
    bsdf = _principled(nodes, _rgb(base_hex), roughness, metallic)

    tex = nodes.new("ShaderNodeTexCoord")
    tex.location = (-760, 20)
    noise = nodes.new("ShaderNodeTexNoise")
    noise.location = (-550, 20)
    noise.inputs["Scale"].default_value = scale
    noise.inputs["Detail"].default_value = detail
    noise.inputs["Roughness"].default_value = 0.52

    ramp = nodes.new("ShaderNodeValToRGB")
    ramp.location = (-290, 80)
    ramp.color_ramp.elements.remove(ramp.color_ramp.elements[1])
    e0 = ramp.color_ramp.elements[0]
    e0.position = 0.26
    e0.color = _rgb(shadow_hex)
    e1 = ramp.color_ramp.elements.new(0.56)
    e1.color = _rgb(base_hex)
    e2 = ramp.color_ramp.elements.new(0.80)
    e2.color = _rgb(light_hex)

    geo = nodes.new("ShaderNodeNewGeometry")
    geo.location = (-530, -260)
    sep = nodes.new("ShaderNodeSeparateXYZ")
    sep.location = (-310, -260)
    orient = nodes.new("ShaderNodeMapRange")
    orient.location = (-80, -250)
    orient.inputs["From Min"].default_value = -0.2
    orient.inputs["From Max"].default_value = 1.0
    orient.inputs["To Min"].default_value = 0.82
    orient.inputs["To Max"].default_value = 1.04
    orient.clamp = True

    multiply = nodes.new("ShaderNodeMixRGB")
    multiply.blend_type = "MULTIPLY"
    multiply.inputs[0].default_value = 1.0
    multiply.location = (150, 100)

    bump = nodes.new("ShaderNodeBump")
    bump.location = (180, -135)
    bump.inputs["Strength"].default_value = bump_strength
    bump.inputs["Distance"].default_value = bump_distance

    links.new(tex.outputs["Generated"], noise.inputs["Vector"])
    links.new(noise.outputs["Fac"], ramp.inputs["Fac"])
    links.new(geo.outputs["Normal"], sep.inputs["Vector"])
    links.new(sep.outputs["Z"], orient.inputs["Value"])
    links.new(ramp.outputs["Color"], multiply.inputs[1])
    links.new(orient.outputs["Result"], multiply.inputs[2])
    links.new(multiply.outputs["Color"], bsdf.inputs["Base Color"])
    links.new(noise.outputs["Fac"], bump.inputs["Height"])
    links.new(bump.outputs["Normal"], bsdf.inputs["Normal"])
    links.new(bsdf.outputs["BSDF"], out.inputs["Surface"])

    _CACHE[name] = mat
    return mat


def create_wood_material(name: str, dark_hex: str, base_hex: str, light_hex: str) -> bpy.types.Material:
    if name in _CACHE:
        return _CACHE[name]
    mat = create_painterly_material(name, dark_hex, base_hex, light_hex, scale=4.5, detail=1.4, roughness=0.86, bump_strength=0.07)
    nodes = mat.node_tree.nodes
    links = mat.node_tree.links
    bsdf = next(n for n in nodes if n.bl_idname == "ShaderNodeBsdfPrincipled")
    # Add very broad banding; it must not read as realistic grain at gameplay scale.
    wave = nodes.new("ShaderNodeTexWave")
    wave.wave_type = "BANDS"
    wave.bands_direction = "Z"
    wave.inputs["Scale"].default_value = 2.4
    wave.inputs["Distortion"].default_value = 2.2
    wave.inputs["Detail"].default_value = 1.2
    wave.location = (-510, -470)
    coord = next(n for n in nodes if n.bl_idname == "ShaderNodeTexCoord")
    bump = nodes.new("ShaderNodeBump")
    bump.location = (160, -320)
    bump.inputs["Strength"].default_value = 0.045
    bump.inputs["Distance"].default_value = 0.055
    links.new(coord.outputs["Generated"], wave.inputs["Vector"])
    links.new(wave.outputs["Color"], bump.inputs["Height"])
    links.new(bump.outputs["Normal"], bsdf.inputs["Normal"])
    return mat


def create_water_material(
    name: str,
    deep_hex: str,
    shallow_hex: str,
    light_hex: str,
    *,
    scale: float = 2.1,
    detail: float = 2.0,
    roughness: float = 0.30,
    bump_strength: float = 0.12,
    bump_distance: float = 0.06,
) -> bpy.types.Material:
    """Painterly water with tunable broad-vs-local variation.

    Water v2 deliberately separates shallow and open-sea frequency ranges: shallow
    water carries a little more local colour movement, while open sea is broader,
    deeper and calmer so the two tile classes remain readable at strategy scale.
    """
    if name in _CACHE:
        return _CACHE[name]
    mat = bpy.data.materials.new(name)
    nodes, links = _clear_nodes(mat)
    out = nodes.new("ShaderNodeOutputMaterial")
    out.location = (650, 0)
    bsdf = _principled(nodes, _rgb(shallow_hex), roughness, 0.0)

    coord = nodes.new("ShaderNodeTexCoord")
    coord.location = (-720, 0)
    noise_a = nodes.new("ShaderNodeTexNoise")
    noise_a.location = (-520, 80)
    noise_a.inputs["Scale"].default_value = scale
    noise_a.inputs["Detail"].default_value = detail
    noise_a.inputs["Roughness"].default_value = 0.44
    noise_b = nodes.new("ShaderNodeTexNoise")
    noise_b.location = (-520, -120)
    noise_b.inputs["Scale"].default_value = scale * 4.0
    noise_b.inputs["Detail"].default_value = max(0.8, detail * 0.55)
    noise_b.inputs["Roughness"].default_value = 0.34

    ramp = nodes.new("ShaderNodeValToRGB")
    ramp.location = (-250, 90)
    ramp.color_ramp.elements[0].position = 0.24
    ramp.color_ramp.elements[0].color = _rgb(deep_hex)
    ramp.color_ramp.elements[1].position = 0.80
    ramp.color_ramp.elements[1].color = _rgb(light_hex)

    bump = nodes.new("ShaderNodeBump")
    bump.location = (130, -100)
    bump.inputs["Strength"].default_value = bump_strength
    bump.inputs["Distance"].default_value = bump_distance

    links.new(coord.outputs["Generated"], noise_a.inputs["Vector"])
    links.new(coord.outputs["Generated"], noise_b.inputs["Vector"])
    links.new(noise_a.outputs["Fac"], ramp.inputs["Fac"])
    links.new(ramp.outputs["Color"], bsdf.inputs["Base Color"])
    links.new(noise_b.outputs["Fac"], bump.inputs["Height"])
    links.new(bump.outputs["Normal"], bsdf.inputs["Normal"])
    links.new(bsdf.outputs["BSDF"], out.inputs["Surface"])
    _CACHE[name] = mat
    return mat


def create_flat_material(name: str, hex_color: str, roughness: float = 0.82, metallic: float = 0.0) -> bpy.types.Material:
    if name in _CACHE:
        return _CACHE[name]
    mat = bpy.data.materials.new(name)
    mat.use_nodes = True
    bsdf = mat.node_tree.nodes.get("Principled BSDF")
    if bsdf:
        bsdf.inputs["Base Color"].default_value = _rgb(hex_color)
        bsdf.inputs["Roughness"].default_value = roughness
        bsdf.inputs["Metallic"].default_value = metallic
    mat.diffuse_color = _rgb(hex_color)
    _CACHE[name] = mat
    return mat


