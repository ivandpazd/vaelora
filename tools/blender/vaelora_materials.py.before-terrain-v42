"""Procedural painterly materials for Vaelora Sculpted Diorama.

The material system intentionally avoids photo textures. Variation is generated from
object-space noise, surface orientation and restrained AO so assets feel authored
rather than uniformly flat while remaining readable at strategy scale.
"""
from __future__ import annotations


import bpy

from vaelora_style import FACTION_PALETTE_HEX, PALETTE_HEX

_CACHE: dict[str, bpy.types.Material] = {}


def hex_rgba(value: str) -> tuple[float, float, float, float]:
    value = value.lstrip("#")
    rgb = tuple(int(value[i:i + 2], 16) / 255.0 for i in (0, 2, 4))
    return (*rgb, 1.0)


def _rgb(value: str):
    return hex_rgba(value)


def _clear_nodes(mat: bpy.types.Material):
    mat.use_nodes = True
    nodes = mat.node_tree.nodes
    for node in list(nodes):
        nodes.remove(node)
    return mat.node_tree.nodes, mat.node_tree.links


def _principled(nodes, base_color, roughness: float, metallic: float = 0.0):
    bsdf = nodes.new("ShaderNodeBsdfPrincipled")
    bsdf.location = (430, 60)
    bsdf.inputs["Base Color"].default_value = base_color
    bsdf.inputs["Roughness"].default_value = roughness
    bsdf.inputs["Metallic"].default_value = metallic
    return bsdf


def create_painterly_material(
    name: str,
    shadow_hex: str,
    base_hex: str,
    light_hex: str,
    *,
    scale: float = 3.2,
    detail: float = 2.0,
    roughness: float = 0.82,
    bump_strength: float = 0.10,
    bump_distance: float = 0.10,
    metallic: float = 0.0,
) -> bpy.types.Material:
    if name in _CACHE:
        return _CACHE[name]
    mat = bpy.data.materials.new(name)
    nodes, links = _clear_nodes(mat)
    out = nodes.new("ShaderNodeOutputMaterial")
    out.location = (680, 60)
    bsdf = _principled(nodes, _rgb(base_hex), roughness, metallic)

    tex = nodes.new("ShaderNodeTexCoord")
    tex.location = (-760, 20)
    noise = nodes.new("ShaderNodeTexNoise")
    noise.location = (-550, 20)
    noise.inputs["Scale"].default_value = scale
    noise.inputs["Detail"].default_value = detail
    noise.inputs["Roughness"].default_value = 0.52

    ramp = nodes.new("ShaderNodeValToRGB")
    ramp.location = (-290, 80)
    ramp.color_ramp.elements.remove(ramp.color_ramp.elements[1])
    e0 = ramp.color_ramp.elements[0]
    e0.position = 0.26
    e0.color = _rgb(shadow_hex)
    e1 = ramp.color_ramp.elements.new(0.56)
    e1.color = _rgb(base_hex)
    e2 = ramp.color_ramp.elements.new(0.80)
    e2.color = _rgb(light_hex)

    geo = nodes.new("ShaderNodeNewGeometry")
    geo.location = (-530, -260)
    sep = nodes.new("ShaderNodeSeparateXYZ")
    sep.location = (-310, -260)
    orient = nodes.new("ShaderNodeMapRange")
    orient.location = (-80, -250)
    orient.inputs["From Min"].default_value = -0.2
    orient.inputs["From Max"].default_value = 1.0
    orient.inputs["To Min"].default_value = 0.82
    orient.inputs["To Max"].default_value = 1.04
    orient.clamp = True

    multiply = nodes.new("ShaderNodeMixRGB")
    multiply.blend_type = "MULTIPLY"
    multiply.inputs[0].default_value = 1.0
    multiply.location = (150, 100)

    bump = nodes.new("ShaderNodeBump")
    bump.location = (180, -135)
    bump.inputs["Strength"].default_value = bump_strength
    bump.inputs["Distance"].default_value = bump_distance

    links.new(tex.outputs["Generated"], noise.inputs["Vector"])
    links.new(noise.outputs["Fac"], ramp.inputs["Fac"])
    links.new(geo.outputs["Normal"], sep.inputs["Vector"])
    links.new(sep.outputs["Z"], orient.inputs["Value"])
    links.new(ramp.outputs["Color"], multiply.inputs[1])
    links.new(orient.outputs["Result"], multiply.inputs[2])
    links.new(multiply.outputs["Color"], bsdf.inputs["Base Color"])
    links.new(noise.outputs["Fac"], bump.inputs["Height"])
    links.new(bump.outputs["Normal"], bsdf.inputs["Normal"])
    links.new(bsdf.outputs["BSDF"], out.inputs["Surface"])

    _CACHE[name] = mat
    return mat



def create_terrain_v3_material(
    name: str,
    shadow_hex: str,
    base_hex: str,
    light_hex: str,
    *,
    broad_scale: float,
    micro_scale: float,
    roughness: float = 0.90,
    bump_strength: float = 0.075,
) -> bpy.types.Material:
    """Terrain v3 material with broad colour masses + restrained fine breakup.

    The broad noise controls the painterly colour field; the high-frequency noise only
    contributes a small amount so 256x128 sprites retain shape instead of noisy grain.
    Surface height and normal orientation gently brighten crests and upper planes.
    """
    if name in _CACHE:
        return _CACHE[name]
    mat = bpy.data.materials.new(name)
    nodes, links = _clear_nodes(mat)
    out = nodes.new("ShaderNodeOutputMaterial")
    out.location = (760, 80)
    bsdf = _principled(nodes, _rgb(base_hex), roughness, 0.0)

    coord = nodes.new("ShaderNodeTexCoord")
    coord.location = (-900, 40)

    broad = nodes.new("ShaderNodeTexNoise")
    broad.location = (-700, 120)
    broad.inputs["Scale"].default_value = broad_scale
    broad.inputs["Detail"].default_value = 1.55
    broad.inputs["Roughness"].default_value = 0.48

    micro = nodes.new("ShaderNodeTexNoise")
    micro.location = (-700, -60)
    micro.inputs["Scale"].default_value = micro_scale
    micro.inputs["Detail"].default_value = 1.10
    micro.inputs["Roughness"].default_value = 0.42

    broad_mul = nodes.new("ShaderNodeMath")
    broad_mul.operation = "MULTIPLY"
    broad_mul.inputs[1].default_value = 0.82
    broad_mul.location = (-490, 120)

    micro_mul = nodes.new("ShaderNodeMath")
    micro_mul.operation = "MULTIPLY"
    micro_mul.inputs[1].default_value = 0.18
    micro_mul.location = (-490, -50)

    mix_fac = nodes.new("ShaderNodeMath")
    mix_fac.operation = "ADD"
    mix_fac.location = (-300, 80)

    ramp = nodes.new("ShaderNodeValToRGB")
    ramp.location = (-100, 120)
    ramp.color_ramp.elements.remove(ramp.color_ramp.elements[1])
    e0 = ramp.color_ramp.elements[0]
    e0.position = 0.18
    e0.color = _rgb(shadow_hex)
    e1 = ramp.color_ramp.elements.new(0.50)
    e1.color = _rgb(base_hex)
    e2 = ramp.color_ramp.elements.new(0.78)
    e2.color = _rgb(light_hex)

    geo = nodes.new("ShaderNodeNewGeometry")
    geo.location = (-250, -300)
    normal_sep = nodes.new("ShaderNodeSeparateXYZ")
    normal_sep.location = (-60, -300)
    orient = nodes.new("ShaderNodeMapRange")
    orient.location = (120, -260)
    orient.inputs["From Min"].default_value = 0.45
    orient.inputs["From Max"].default_value = 1.0
    orient.inputs["To Min"].default_value = 0.90
    orient.inputs["To Max"].default_value = 1.07
    orient.clamp = True

    pos_sep = nodes.new("ShaderNodeSeparateXYZ")
    pos_sep.location = (-60, -430)
    height_map = nodes.new("ShaderNodeMapRange")
    height_map.location = (120, -410)
    height_map.inputs["From Min"].default_value = -0.03
    height_map.inputs["From Max"].default_value = 0.46
    height_map.inputs["To Min"].default_value = 0.94
    height_map.inputs["To Max"].default_value = 1.06
    height_map.clamp = True

    light_mul = nodes.new("ShaderNodeMath")
    light_mul.operation = "MULTIPLY"
    light_mul.location = (320, -310)

    color_mul = nodes.new("ShaderNodeMixRGB")
    color_mul.blend_type = "MULTIPLY"
    color_mul.inputs[0].default_value = 1.0
    color_mul.location = (360, 120)

    bump = nodes.new("ShaderNodeBump")
    bump.location = (390, -80)
    bump.inputs["Strength"].default_value = bump_strength
    bump.inputs["Distance"].default_value = 0.055

    links.new(coord.outputs["Generated"], broad.inputs["Vector"])
    links.new(coord.outputs["Generated"], micro.inputs["Vector"])
    links.new(broad.outputs["Fac"], broad_mul.inputs[0])
    links.new(micro.outputs["Fac"], micro_mul.inputs[0])
    links.new(broad_mul.outputs[0], mix_fac.inputs[0])
    links.new(micro_mul.outputs[0], mix_fac.inputs[1])
    links.new(mix_fac.outputs[0], ramp.inputs["Fac"])

    links.new(geo.outputs["Normal"], normal_sep.inputs["Vector"])
    links.new(normal_sep.outputs["Z"], orient.inputs["Value"])
    links.new(geo.outputs["Position"], pos_sep.inputs["Vector"])
    links.new(pos_sep.outputs["Z"], height_map.inputs["Value"])
    links.new(orient.outputs["Result"], light_mul.inputs[0])
    links.new(height_map.outputs["Result"], light_mul.inputs[1])

    links.new(ramp.outputs["Color"], color_mul.inputs[1])
    links.new(light_mul.outputs[0], color_mul.inputs[2])
    links.new(color_mul.outputs["Color"], bsdf.inputs["Base Color"])
    links.new(micro.outputs["Fac"], bump.inputs["Height"])
    links.new(bump.outputs["Normal"], bsdf.inputs["Normal"])
    links.new(bsdf.outputs["BSDF"], out.inputs["Surface"])

    _CACHE[name] = mat
    return mat

def create_terrain_v4_meadow_material(name: str = "VAE_MeadowV41") -> bpy.types.Material:
    """Terrain v4.1 painterly meadow material.

    R = sun/warm grass, G = exposed earth, B = cool/moist valley. Broad colour
    masses and directional brush breakup dominate; high-frequency noise is subordinate.
    """
    if name in _CACHE:
        return _CACHE[name]
    mat = bpy.data.materials.new(name)
    nodes, links = _clear_nodes(mat)
    out = nodes.new("ShaderNodeOutputMaterial")
    out.location = (1260, 80)
    bsdf = _principled(nodes, _rgb("#6DA735"), 0.84, 0.0)

    coord = nodes.new("ShaderNodeTexCoord")
    coord.location = (-1180, 80)

    broad = nodes.new("ShaderNodeTexNoise")
    broad.location = (-1010, 190)
    broad.inputs["Scale"].default_value = 0.95
    broad.inputs["Detail"].default_value = 1.10
    broad.inputs["Roughness"].default_value = 0.38

    broad_ramp = nodes.new("ShaderNodeValToRGB")
    broad_ramp.location = (-810, 190)
    broad_ramp.color_ramp.elements.remove(broad_ramp.color_ramp.elements[1])
    b0 = broad_ramp.color_ramp.elements[0]
    b0.position = 0.16
    b0.color = _rgb("#2A5B27")
    b1 = broad_ramp.color_ramp.elements.new(0.48)
    b1.color = _rgb("#659B31")
    b2 = broad_ramp.color_ramp.elements.new(0.78)
    b2.color = _rgb("#A6C944")
    b3 = broad_ramp.color_ramp.elements.new(0.93)
    b3.color = _rgb("#C7D94C")

    # Directional distorted bands provide subtle painterly grass-flow strokes.
    wave = nodes.new("ShaderNodeTexWave")
    wave.location = (-1000, -20)
    wave.wave_type = "BANDS"
    wave.bands_direction = "X"
    wave.inputs["Scale"].default_value = 6.2
    wave.inputs["Distortion"].default_value = 7.0
    wave.inputs["Detail"].default_value = 3.0

    brush_ramp = nodes.new("ShaderNodeValToRGB")
    brush_ramp.location = (-800, -20)
    brush_ramp.color_ramp.elements[0].position = 0.32
    brush_ramp.color_ramp.elements[0].color = _rgb("#315F27")
    brush_ramp.color_ramp.elements[1].position = 0.72
    brush_ramp.color_ramp.elements[1].color = _rgb("#C3D64B")

    brush_mix = nodes.new("ShaderNodeMixRGB")
    brush_mix.blend_type = "SOFT_LIGHT"
    brush_mix.location = (-575, 150)
    brush_mix.inputs[0].default_value = 0.34

    attr = nodes.new("ShaderNodeVertexColor")
    attr.layer_name = "vae_terrain_mask"
    attr.location = (-760, -250)
    separate = nodes.new("ShaderNodeSeparateColor")
    separate.mode = "RGB"
    separate.location = (-560, -250)

    sun_factor = nodes.new("ShaderNodeMath")
    sun_factor.operation = "MULTIPLY"
    sun_factor.inputs[1].default_value = 0.96
    sun_factor.location = (-350, -210)
    earth_factor = nodes.new("ShaderNodeMath")
    earth_factor.operation = "MULTIPLY"
    earth_factor.inputs[1].default_value = 0.90
    earth_factor.location = (-350, -270)
    cool_factor = nodes.new("ShaderNodeMath")
    cool_factor.operation = "MULTIPLY"
    cool_factor.inputs[1].default_value = 0.78
    cool_factor.location = (-350, -330)

    sun_mix = nodes.new("ShaderNodeMixRGB")
    sun_mix.blend_type = "MIX"
    sun_mix.location = (-120, 190)
    sun_mix.inputs[2].default_value = _rgb("#DDE65A")
    earth_mix = nodes.new("ShaderNodeMixRGB")
    earth_mix.blend_type = "MIX"
    earth_mix.location = (100, 165)
    earth_mix.inputs[2].default_value = _rgb("#AE693D")
    cool_mix = nodes.new("ShaderNodeMixRGB")
    cool_mix.blend_type = "MIX"
    cool_mix.location = (320, 145)
    cool_mix.inputs[2].default_value = _rgb("#285729")

    geo = nodes.new("ShaderNodeNewGeometry")
    geo.location = (-220, -500)
    normal_sep = nodes.new("ShaderNodeSeparateXYZ")
    normal_sep.location = (-20, -470)
    orient = nodes.new("ShaderNodeMapRange")
    orient.location = (180, -450)
    orient.inputs["From Min"].default_value = 0.30
    orient.inputs["From Max"].default_value = 1.0
    orient.inputs["To Min"].default_value = 0.74
    orient.inputs["To Max"].default_value = 1.10
    orient.clamp = True

    pos_sep = nodes.new("ShaderNodeSeparateXYZ")
    pos_sep.location = (-20, -590)
    height_map = nodes.new("ShaderNodeMapRange")
    height_map.location = (180, -570)
    height_map.inputs["From Min"].default_value = -0.08
    height_map.inputs["From Max"].default_value = 0.66
    height_map.inputs["To Min"].default_value = 0.84
    height_map.inputs["To Max"].default_value = 1.17
    height_map.clamp = True

    light_mul = nodes.new("ShaderNodeMath")
    light_mul.operation = "MULTIPLY"
    light_mul.location = (395, -500)
    final_mul = nodes.new("ShaderNodeMixRGB")
    final_mul.blend_type = "MULTIPLY"
    final_mul.inputs[0].default_value = 1.0
    final_mul.location = (585, 120)

    micro = nodes.new("ShaderNodeTexNoise")
    micro.location = (330, -260)
    micro.inputs["Scale"].default_value = 13.0
    micro.inputs["Detail"].default_value = 1.0
    micro.inputs["Roughness"].default_value = 0.34
    bump = nodes.new("ShaderNodeBump")
    bump.location = (780, -90)
    bump.inputs["Strength"].default_value = 0.065
    bump.inputs["Distance"].default_value = 0.030

    links.new(coord.outputs["Generated"], broad.inputs["Vector"])
    links.new(coord.outputs["Generated"], wave.inputs["Vector"])
    links.new(coord.outputs["Generated"], micro.inputs["Vector"])
    links.new(broad.outputs["Fac"], broad_ramp.inputs["Fac"])
    links.new(wave.outputs["Color"], brush_ramp.inputs["Fac"])
    links.new(broad_ramp.outputs["Color"], brush_mix.inputs[1])
    links.new(brush_ramp.outputs["Color"], brush_mix.inputs[2])

    links.new(attr.outputs["Color"], separate.inputs["Color"])
    links.new(separate.outputs["Red"], sun_factor.inputs[0])
    links.new(separate.outputs["Green"], earth_factor.inputs[0])
    links.new(separate.outputs["Blue"], cool_factor.inputs[0])
    links.new(sun_factor.outputs[0], sun_mix.inputs[0])
    links.new(brush_mix.outputs["Color"], sun_mix.inputs[1])
    links.new(earth_factor.outputs[0], earth_mix.inputs[0])
    links.new(sun_mix.outputs["Color"], earth_mix.inputs[1])
    links.new(cool_factor.outputs[0], cool_mix.inputs[0])
    links.new(earth_mix.outputs["Color"], cool_mix.inputs[1])

    links.new(geo.outputs["Normal"], normal_sep.inputs["Vector"])
    links.new(normal_sep.outputs["Z"], orient.inputs["Value"])
    links.new(geo.outputs["Position"], pos_sep.inputs["Vector"])
    links.new(pos_sep.outputs["Z"], height_map.inputs["Value"])
    links.new(orient.outputs["Result"], light_mul.inputs[0])
    links.new(height_map.outputs["Result"], light_mul.inputs[1])
    links.new(cool_mix.outputs["Color"], final_mul.inputs[1])
    links.new(light_mul.outputs[0], final_mul.inputs[2])
    links.new(final_mul.outputs["Color"], bsdf.inputs["Base Color"])
    links.new(micro.outputs["Fac"], bump.inputs["Height"])
    links.new(bump.outputs["Normal"], bsdf.inputs["Normal"])
    links.new(bsdf.outputs["BSDF"], out.inputs["Surface"])

    _CACHE[name] = mat
    return mat

def create_wood_material(name: str, dark_hex: str, base_hex: str, light_hex: str) -> bpy.types.Material:
    if name in _CACHE:
        return _CACHE[name]
    mat = create_painterly_material(name, dark_hex, base_hex, light_hex, scale=4.5, detail=1.4, roughness=0.86, bump_strength=0.07)
    nodes = mat.node_tree.nodes
    links = mat.node_tree.links
    bsdf = next(n for n in nodes if n.bl_idname == "ShaderNodeBsdfPrincipled")
    # Add very broad banding; it must not read as realistic grain at gameplay scale.
    wave = nodes.new("ShaderNodeTexWave")
    wave.wave_type = "BANDS"
    wave.bands_direction = "Z"
    wave.inputs["Scale"].default_value = 2.4
    wave.inputs["Distortion"].default_value = 2.2
    wave.inputs["Detail"].default_value = 1.2
    wave.location = (-510, -470)
    coord = next(n for n in nodes if n.bl_idname == "ShaderNodeTexCoord")
    bump = nodes.new("ShaderNodeBump")
    bump.location = (160, -320)
    bump.inputs["Strength"].default_value = 0.045
    bump.inputs["Distance"].default_value = 0.055
    links.new(coord.outputs["Generated"], wave.inputs["Vector"])
    links.new(wave.outputs["Color"], bump.inputs["Height"])
    links.new(bump.outputs["Normal"], bsdf.inputs["Normal"])
    return mat


def create_water_material(
    name: str,
    deep_hex: str,
    shallow_hex: str,
    light_hex: str,
    *,
    scale: float = 2.1,
    detail: float = 2.0,
    roughness: float = 0.30,
    bump_strength: float = 0.12,
    bump_distance: float = 0.06,
) -> bpy.types.Material:
    """Painterly water with tunable broad-vs-local variation.

    Water v2 deliberately separates shallow and open-sea frequency ranges: shallow
    water carries a little more local colour movement, while open sea is broader,
    deeper and calmer so the two tile classes remain readable at strategy scale.
    """
    if name in _CACHE:
        return _CACHE[name]
    mat = bpy.data.materials.new(name)
    nodes, links = _clear_nodes(mat)
    out = nodes.new("ShaderNodeOutputMaterial")
    out.location = (650, 0)
    bsdf = _principled(nodes, _rgb(shallow_hex), roughness, 0.0)

    coord = nodes.new("ShaderNodeTexCoord")
    coord.location = (-720, 0)
    noise_a = nodes.new("ShaderNodeTexNoise")
    noise_a.location = (-520, 80)
    noise_a.inputs["Scale"].default_value = scale
    noise_a.inputs["Detail"].default_value = detail
    noise_a.inputs["Roughness"].default_value = 0.44
    noise_b = nodes.new("ShaderNodeTexNoise")
    noise_b.location = (-520, -120)
    noise_b.inputs["Scale"].default_value = scale * 4.0
    noise_b.inputs["Detail"].default_value = max(0.8, detail * 0.55)
    noise_b.inputs["Roughness"].default_value = 0.34

    ramp = nodes.new("ShaderNodeValToRGB")
    ramp.location = (-250, 90)
    ramp.color_ramp.elements[0].position = 0.24
    ramp.color_ramp.elements[0].color = _rgb(deep_hex)
    ramp.color_ramp.elements[1].position = 0.80
    ramp.color_ramp.elements[1].color = _rgb(light_hex)

    bump = nodes.new("ShaderNodeBump")
    bump.location = (130, -100)
    bump.inputs["Strength"].default_value = bump_strength
    bump.inputs["Distance"].default_value = bump_distance

    links.new(coord.outputs["Generated"], noise_a.inputs["Vector"])
    links.new(coord.outputs["Generated"], noise_b.inputs["Vector"])
    links.new(noise_a.outputs["Fac"], ramp.inputs["Fac"])
    links.new(ramp.outputs["Color"], bsdf.inputs["Base Color"])
    links.new(noise_b.outputs["Fac"], bump.inputs["Height"])
    links.new(bump.outputs["Normal"], bsdf.inputs["Normal"])
    links.new(bsdf.outputs["BSDF"], out.inputs["Surface"])
    _CACHE[name] = mat
    return mat


def create_flat_material(name: str, hex_color: str, roughness: float = 0.82, metallic: float = 0.0) -> bpy.types.Material:
    if name in _CACHE:
        return _CACHE[name]
    mat = bpy.data.materials.new(name)
    mat.use_nodes = True
    bsdf = mat.node_tree.nodes.get("Principled BSDF")
    if bsdf:
        bsdf.inputs["Base Color"].default_value = _rgb(hex_color)
        bsdf.inputs["Roughness"].default_value = roughness
        bsdf.inputs["Metallic"].default_value = metallic
    mat.diffuse_color = _rgb(hex_color)
    _CACHE[name] = mat
    return mat


